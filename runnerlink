#!/usr/bin/env bash
# RunnerLink — Your only Actions gateway.
# Launch the RunnerLink desktop app.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Ensure Python 3 and Tk are available
if ! command -v python3 >/dev/null 2>&1; then
    echo "error: python3 is required but not found" >&2
    exit 1
fi

python3 -c "import tkinter" 2>/dev/null || {
    echo "error: python3-tk is required — install it with:" >&2
    echo "  sudo apt install python3-tk   # Debian/Ubuntu" >&2
    echo "  brew install python-tk         # macOS" >&2
    exit 1
}

exec python3 "$SCRIPT_DIR/helper-widget/runner_widget.py" "$@"
